.progress-ring {
  width: 410rpx;
  height: 410rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 50%;
  background: #dfeae5;
}
.progress-ring__inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
}
