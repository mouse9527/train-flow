.stats-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx; padding-bottom: 56rpx; background: #f3f7f4; color: #17231f; }
.stats-hero, .empty-card, .metric-card, .section-card, .privacy-card, .error-card { border: 1rpx solid rgba(31, 111, 84, .1); border-radius: 26rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(31, 75, 58, .07); }
.stats-hero { padding: 32rpx; color: #fff; background: linear-gradient(135deg, #1f5d47, #2f8062); }
.stats-hero__eyebrow, .stats-hero__value, .stats-hero__label { display: block; }
.stats-hero__eyebrow { font-size: 24rpx; opacity: .82; }
.stats-hero__row { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 24rpx; }
.stats-hero__value { font-size: 70rpx; font-weight: 800; line-height: 1; }
.stats-hero__label, .stats-hero__count { margin-top: 10rpx; font-size: 25rpx; }
.empty-card { margin-top: 22rpx; padding: 28rpx; background: #fff8e8; border-color: #ead8a3; }
.empty-card__title, .empty-card__copy { display: block; }
.empty-card__title { font-size: 30rpx; font-weight: 800; }
.empty-card__copy { margin-top: 10rpx; color: #705d31; font-size: 24rpx; line-height: 1.6; }
.metric-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; margin-top: 22rpx; }
.metric-card { min-width: 0; padding: 26rpx; }
.metric-card--wide { grid-column: 1 / -1; }
.metric-card__value { font-size: 42rpx; font-weight: 800; }
.metric-card__unit { margin-left: 8rpx; color: #50645c; font-size: 22rpx; }
.metric-card__label, .metric-card__note { display: block; }
.metric-card__label { margin-top: 10rpx; font-size: 24rpx; font-weight: 700; }
.metric-card__note { margin-top: 6rpx; color: #718078; font-size: 20rpx; line-height: 1.45; }
.section-card { margin-top: 22rpx; padding: 28rpx; }
.section-card__title, .section-card__copy { display: block; }
.section-card__title { font-size: 32rpx; font-weight: 800; }
.section-card__copy { margin-top: 8rpx; color: #6d7a74; font-size: 22rpx; line-height: 1.55; }
.latest-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 22rpx; }
.latest-item { min-width: 0; padding: 20rpx 14rpx; border-radius: 20rpx; background: #f3f8f5; text-align: center; }
.latest-item__label, .latest-item__value, .latest-item__date { display: block; }
.latest-item__label { color: #587067; font-size: 21rpx; }
.latest-item__value { margin-top: 9rpx; font-size: 27rpx; font-weight: 800; overflow-wrap: anywhere; }
.latest-item__date { min-height: 30rpx; margin-top: 6rpx; color: #7c8983; font-size: 19rpx; }
.trend { margin-top: 30rpx; }
.trend + .trend { padding-top: 26rpx; border-top: 1rpx solid #e5ece8; }
.trend__header { display: flex; align-items: center; justify-content: space-between; }
.trend__title { font-size: 26rpx; font-weight: 800; }
.trend__unit { color: #708079; font-size: 21rpx; }
.trend-bars { display: flex; align-items: flex-end; min-height: 230rpx; gap: 12rpx; margin-top: 18rpx; overflow: hidden; }
.trend-point { flex: 1; min-width: 0; text-align: center; }
.trend-bar { position: relative; height: 130rpx; border-radius: 12rpx; background: #edf2ef; overflow: hidden; }
.trend-bar__fill { position: absolute; right: 0; bottom: 0; left: 0; min-height: 8rpx; border-radius: 12rpx; background: linear-gradient(180deg, #5aaf8b, #267458); }
.trend-bar__fill--unknown { min-height: 0; background: transparent; }
.trend-point__value, .trend-point__date { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.trend-point__value { margin-top: 8rpx; font-size: 19rpx; font-weight: 700; }
.trend-point__date { margin-top: 4rpx; color: #78857f; font-size: 18rpx; }
.trend__empty { align-self: center; width: 100%; color: #7b8782; font-size: 23rpx; text-align: center; }
.privacy-card { margin-top: 22rpx; padding: 22rpx 26rpx; color: #617069; font-size: 22rpx; line-height: 1.6; }
.error-card { padding: 28rpx; }
.error-card__title, .error-card__copy { display: block; }
.error-card__title { font-size: 30rpx; font-weight: 800; }
.error-card__copy { margin-top: 10rpx; color: #a13d3f; font-size: 23rpx; }
@media (max-width: 360px) { .stats-page { padding-left: 20rpx; padding-right: 20rpx; } .latest-grid { grid-template-columns: 1fr; } .trend-bars { gap: 8rpx; } }
