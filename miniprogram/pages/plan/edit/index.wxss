.editor-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 80rpx;
  background: #eef2f5;
  color: #17212b;
  box-sizing: border-box;
}

.editor-hero {
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #13283b, #214f70);
  box-shadow: 0 18rpx 40rpx rgba(19, 40, 59, 0.18);
  color: #ffffff;
}

.eyebrow {
  color: #75c9ff;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-row,
.section-heading,
.step-editor-head,
.add-step-row,
.copy-row,
.optional-row,
.confirmation-actions {
  display: flex;
  align-items: center;
}

.hero-row {
  justify-content: space-between;
  margin-top: 14rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-date {
  display: block;
  margin-top: 6rpx;
  color: #b8d2e5;
  font-size: 22rpx;
}

.draft-chip {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(117, 201, 255, 0.45);
  border-radius: 999rpx;
  background: rgba(117, 201, 255, 0.12);
  color: #bfe7ff;
  font-size: 20rpx;
}

.future-notice {
  display: block;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #d9e6ef;
  font-size: 23rpx;
  line-height: 1.55;
}

.editor-section {
  margin-top: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #dfe5ea;
  border-radius: 24rpx;
  background: #ffffff;
}

.section-heading {
  align-items: flex-start;
  margin-bottom: 26rpx;
}

.section-number {
  flex: none;
  margin-right: 16rpx;
  color: #2376c9;
  font-family: monospace;
  font-size: 22rpx;
  font-weight: 700;
}

.section-title {
  font-size: 31rpx;
  font-weight: 700;
}

.section-copy {
  display: block;
  margin-top: 6rpx;
  color: #788592;
  font-size: 21rpx;
  line-height: 1.5;
}

.field-label {
  display: block;
  margin: 20rpx 0 8rpx;
  color: #465462;
  font-size: 22rpx;
  font-weight: 600;
}

.field-input,
.field-textarea,
.picker-value {
  width: 100%;
  border: 1rpx solid #d6dee5;
  border-radius: 13rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.field-input,
.picker-value {
  min-height: 76rpx;
  padding: 0 20rpx;
  font-size: 25rpx;
  line-height: 76rpx;
}

.field-textarea {
  min-height: 116rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.field-invalid {
  border-color: #d64b42;
  background: #fff7f6;
}

.field-error,
.error-banner,
.copy-error {
  color: #b7352d;
}

.field-error {
  display: block;
  margin-top: 7rpx;
  font-size: 20rpx;
}

.error-banner,
.save-banner {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
}

.error-banner {
  border: 1rpx solid #f0b8b4;
  background: #fff4f3;
}

.save-banner {
  border: 1rpx solid #a8d8bd;
  background: #effaf3;
  color: #28734a;
}

.step-editor {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #dde5eb;
  border-left: 6rpx solid #2376c9;
  border-radius: 18rpx;
  background: #fbfcfd;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  background: #e8f3fd;
  color: #216aae;
  font-weight: 700;
}

.step-identity {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.step-kind {
  color: #273746;
  font-size: 23rpx;
  font-weight: 700;
  text-transform: uppercase;
}

.step-id {
  overflow: hidden;
  margin-top: 2rpx;
  color: #929da7;
  font-family: monospace;
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.step-actions {
  display: flex;
  margin-left: 8rpx;
}

.icon-button {
  width: 56rpx;
  min-width: 56rpx;
  margin: 0 0 0 7rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #edf2f6;
  color: #425466;
  font-size: 23rpx;
  line-height: 54rpx;
}

.icon-button.danger {
  background: #fff0ef;
  color: #b84037;
  font-size: 19rpx;
}

.icon-button::after,
.add-step-button::after,
.save-button::after,
.copy-button::after,
.cancel-button::after,
.confirm-button::after {
  border: none;
}

.field-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -7rpx;
}

.field-cell {
  width: 50%;
  padding: 0 7rpx;
  box-sizing: border-box;
}

.compact {
  min-height: 68rpx;
  line-height: 68rpx;
}

.target-panel {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #edf4f9;
}

.target-title {
  color: #35566f;
  font-size: 21rpx;
  font-weight: 700;
}

.target-line {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.target-name {
  width: 150rpx;
  color: #526879;
  font-size: 21rpx;
}

.target-input {
  flex: 1;
  height: 60rpx;
  padding: 0 12rpx;
  border: 1rpx solid #c8d7e2;
  border-radius: 10rpx;
  background: #ffffff;
  font-size: 22rpx;
  box-sizing: border-box;
}

.target-separator {
  margin: 0 10rpx;
  color: #8394a1;
}

.optional-row {
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 15rpx 0;
}

.inline-label {
  margin: 0;
}

.field-hint {
  display: block;
  margin-top: 5rpx;
  color: #8a96a1;
  font-size: 19rpx;
}

.add-step-row,
.copy-row {
  margin-top: 22rpx;
}

.kind-picker,
.date-picker {
  flex: 1;
}

.add-step-button,
.copy-button {
  flex: none;
  margin: 0 0 0 14rpx;
  border-radius: 13rpx;
  background: #e7f2fc;
  color: #216db2;
  font-size: 23rpx;
  line-height: 76rpx;
}

.save-button {
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #2376c9;
  box-shadow: 0 12rpx 24rpx rgba(35, 118, 201, 0.2);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.copy-section {
  border-top: 6rpx solid #efaa3d;
}

.copy-message {
  display: block;
  margin-top: 14rpx;
  color: #28734a;
  font-size: 22rpx;
}

.confirmation-card {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #efc16f;
  border-radius: 16rpx;
  background: #fff9eb;
}

.confirmation-label {
  color: #9b6110;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.confirmation-message,
.confirmation-revision {
  display: block;
  margin-top: 10rpx;
  color: #5f5039;
  font-size: 22rpx;
  line-height: 1.5;
}

.confirmation-revision {
  color: #8b7555;
  font-family: monospace;
  font-size: 18rpx;
}

.confirmation-actions {
  margin-top: 20rpx;
}

.cancel-button,
.confirm-button {
  flex: 1;
  margin: 0;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 72rpx;
}

.cancel-button {
  margin-right: 10rpx;
  background: #f0f2f4;
  color: #596775;
}

.confirm-button {
  margin-left: 10rpx;
  background: #b76516;
  color: #ffffff;
}
