.plan-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 12rpx 8rpx 28rpx;
}

.plan-kicker {
  display: block;
  margin-bottom: 8rpx;
  color: #2d7dd2;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.plan-title {
  color: #17212b;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.plan-range {
  display: block;
  margin-top: 8rpx;
  color: #7b8794;
  font-size: 24rpx;
}

.plan-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 96rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid #dce8f5;
  border-radius: 18rpx;
  background: #eef6ff;
}

.plan-count-number {
  color: #1f6fbd;
  font-size: 36rpx;
  font-weight: 700;
}

.plan-count-label {
  color: #52728f;
  font-size: 20rpx;
}

.week-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 10rpx;
  border-radius: 16rpx;
  background: #e9edf2;
}

.week-nav-button {
  width: 190rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #2f3e4d;
  font-size: 24rpx;
  line-height: 68rpx;
}

.week-nav-button::after,
.start-workout::after {
  border: none;
}

.week-nav-current {
  color: #6b7785;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.empty-week {
  min-height: 360rpx;
  margin-bottom: 24rpx;
  border: 2rpx dashed #d7dee6;
  border-radius: 20rpx;
  background: #ffffff;
  justify-content: center;
}

.empty-icon {
  margin-bottom: 20rpx;
  color: #9aa5b1;
  font-size: 70rpx;
}

.empty-title {
  margin-bottom: 10rpx;
  color: #364152;
  font-size: 30rpx;
  font-weight: 600;
}

.week-list {
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid #e1e7ee;
  border-radius: 20rpx;
  background: #ffffff;
}

.day-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid #edf0f3;
  box-sizing: border-box;
}

.day-row:last-child {
  border-bottom: none;
}

.day-row-selected {
  background: #eef6ff;
  box-shadow: inset 6rpx 0 #2d7dd2;
}

.day-date {
  display: flex;
  flex: 0 0 112rpx;
  flex-direction: column;
}

.day-weekday {
  color: #25313c;
  font-size: 28rpx;
  font-weight: 700;
}

.day-number {
  margin-top: 4rpx;
  color: #8792a2;
  font-size: 20rpx;
}

.day-main {
  flex: 1;
  min-width: 0;
}

.day-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-title {
  overflow: hidden;
  color: #25313c;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-duration {
  flex: none;
  margin-left: 12rpx;
  color: #2369a8;
  font-size: 21rpx;
  font-weight: 600;
}

.day-duration-rest {
  color: #4f7e62;
}

.day-statuses {
  display: flex;
  margin-top: 10rpx;
}

.status-chip {
  margin-right: 8rpx;
  padding: 4rpx 9rpx;
  border-radius: 999rpx;
  background: #f0f2f5;
  color: #737f8c;
  font-size: 18rpx;
}

.status-primary {
  background: #e5f1ff;
  color: #286aab;
}

.status-alert {
  background: #fff0ee;
  color: #b33b30;
}

.day-chevron {
  margin-left: 12rpx;
  color: #a5afb9;
  font-size: 36rpx;
}

.detail-card {
  padding: 28rpx;
  border-radius: 22rpx;
  background: #182735;
  color: #ffffff;
}

.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.detail-date {
  color: #8fbbe3;
  font-size: 22rpx;
}

.detail-title {
  max-width: 460rpx;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.detail-duration {
  flex: none;
  margin-left: 20rpx;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: #284760;
  color: #cde8ff;
  font-size: 20rpx;
}

.detail-rest {
  background: #244534;
  color: #c7ebd4;
}

.detail-summary {
  display: block;
  margin-top: 18rpx;
  color: #bfccd8;
  font-size: 24rpx;
  line-height: 1.6;
}

.start-workout {
  margin: 24rpx 0;
  border-radius: 14rpx;
  background: #2d7dd2;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 82rpx;
}

.rest-guidance {
  display: flex;
  flex-direction: column;
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid #3c624c;
  border-radius: 14rpx;
  background: #20382c;
}

.rest-guidance-label {
  color: #85c49c;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.rest-guidance-copy {
  margin-top: 8rpx;
  color: #d8eadf;
  font-size: 25rpx;
  line-height: 1.6;
}

.step-list {
  margin-top: 12rpx;
}

.step-card {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #24313d;
}

.step-topline {
  display: flex;
  align-items: center;
}

.step-order {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  background: #e7f2fd;
  color: #286caa;
  font-size: 22rpx;
  font-weight: 700;
}

.step-name-wrap {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.step-name {
  font-size: 27rpx;
  font-weight: 700;
}

.step-kind {
  margin-top: 2rpx;
  color: #8b96a2;
  font-size: 18rpx;
  text-transform: uppercase;
}

.optional-chip {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: #fff2dc;
  color: #956214;
  font-size: 18rpx;
}

.step-description {
  display: block;
  margin: 14rpx 0;
  color: #65717d;
  font-size: 23rpx;
  line-height: 1.55;
}

.metric-grid {
  display: flex;
  margin: 10rpx -5rpx;
}

.metric {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin: 0 5rpx;
  padding: 12rpx;
  border-radius: 10rpx;
  background: #f3f6f9;
}

.metric-label,
.target-label {
  color: #8a96a2;
  font-size: 19rpx;
}

.metric-value,
.target-value {
  margin-top: 3rpx;
  color: #263542;
  font-size: 23rpx;
  font-weight: 600;
}

.target-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #eef1f4;
}

.step-safety {
  margin-top: 10rpx;
  color: #a75b23;
  font-size: 21rpx;
  line-height: 1.5;
}

.safety-panel {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #5a4b32;
  border-radius: 14rpx;
  background: #2a2d2e;
}

.safety-title {
  margin-bottom: 8rpx;
  color: #f2c878;
  font-size: 22rpx;
  font-weight: 700;
}

.safety-copy {
  margin-top: 6rpx;
  color: #d5d9dc;
  font-size: 22rpx;
  line-height: 1.5;
}
