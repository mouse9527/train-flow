.workout-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f4f7f5;
  color: #17231f;
}

.workout-hero,
.target-card,
.expiry-card,
.control-panel,
.terminal-card,
.recovery-card {
  border: 1rpx solid rgba(34, 86, 67, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(31, 75, 58, 0.08);
}

.workout-hero { padding: 30rpx; }
.workout-hero__topline,
.workout-hero__meta,
.adjust-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.workout-hero__position,
.target-card__label,
.expiry-card__eyebrow,
.recovery-card__eyebrow {
  color: #23745b;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.workout-hero__clock { color: #6c7a74; font-size: 24rpx; }
.workout-hero__title { display: block; margin-top: 18rpx; font-size: 44rpx; font-weight: 800; }
.workout-hero__description { display: block; margin-top: 12rpx; color: #5f6e68; font-size: 27rpx; line-height: 1.6; }
.workout-hero__meta { margin-top: 26rpx; color: #52635c; font-size: 24rpx; }

.target-card { margin-top: 22rpx; padding: 24rpx 28rpx; }
.target-card__label { display: block; }
.target-card__value { display: block; margin-top: 8rpx; font-size: 30rpx; font-weight: 700; }

.expiry-card { margin-top: 22rpx; padding: 26rpx; border-color: rgba(218, 136, 37, 0.24); background: #fff9ed; }
.expiry-card__title,
.terminal-card__title,
.recovery-card__title { display: block; margin-top: 8rpx; font-size: 34rpx; font-weight: 800; }
.expiry-card__copy,
.terminal-card__copy,
.recovery-card__message,
.recovery-card__hint { display: block; margin-top: 10rpx; color: #6d6252; font-size: 25rpx; line-height: 1.55; }

.control-panel { margin-top: 22rpx; padding: 24rpx; }
.control-panel__primary,
.control-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.adjust-row { margin: 18rpx 0; padding: 16rpx; border-radius: 22rpx; background: #eef5f1; }
.adjust-row__label { color: #56665f; font-size: 24rpx; }
.control {
  min-height: 96rpx;
  margin: 0;
  padding: 20rpx 16rpx;
  border: 0;
  border-radius: 22rpx;
  background: #e8efeb;
  color: #24493c;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.25;
}
.control::after { border: 0; }
.control[disabled] { opacity: 0.38; }
.control--primary { background: #226d55; color: #ffffff; }
.control--danger { margin-top: 18rpx; background: #fff0ee; color: #a33f34; }
.control--wide { width: 100%; margin-top: 20rpx; }
.control--compact { min-width: 150rpx; min-height: 80rpx; padding: 16rpx; }

.terminal-card,
.recovery-card { margin-top: 22rpx; padding: 32rpx; text-align: center; }

@media (max-width: 360px) {
  .workout-page { padding-left: 20rpx; padding-right: 20rpx; }
  .control { font-size: 24rpx; padding-left: 10rpx; padding-right: 10rpx; }
}
