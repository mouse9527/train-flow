<view class="tf-page" wx:if="{{settings}}">
  <view class="tf-tabs">
    <view
      class="tf-tab {{section === 'preferences' ? 'tf-tab-active' : ''}}"
      data-section="preferences"
      bindtap="onSwitchSection"
    >训练偏好</view>
    <view
      class="tf-tab {{section === 'about' ? 'tf-tab-active' : ''}}"
      data-section="about"
      bindtap="onSwitchSection"
    >关于与安全</view>
    <view
      class="tf-tab {{section === 'data' ? 'tf-tab-active' : ''}}"
      data-section="data"
      bindtap="onSwitchSection"
    >本机数据</view>
  </view>

  <view class="tf-section" wx:if="{{section === 'preferences'}}">
    <view class="tf-section-title">训练偏好</view>

    <view class="tf-row">
      <text class="tf-row-label">振动提醒</text>
      <switch checked="{{settings.vibrationEnabled}}" data-field="vibrationEnabled" bindchange="onToggleField" />
    </view>
    <view class="tf-row">
      <text class="tf-row-label">提示音</text>
      <switch checked="{{settings.soundEnabled}}" data-field="soundEnabled" bindchange="onToggleField" />
    </view>
    <view class="tf-row">
      <text class="tf-row-label">语音提示（预留，暂不提供 TTS）</text>
      <switch checked="{{settings.voiceEnabled}}" data-field="voiceEnabled" bindchange="onToggleField" />
    </view>
    <view class="tf-row">
      <text class="tf-row-label">训练中保持屏幕常亮</text>
      <switch checked="{{settings.keepScreenOn}}" data-field="keepScreenOn" bindchange="onToggleField" />
    </view>
    <view class="tf-row">
      <text class="tf-row-label">默认开始时间</text>
      <picker
        mode="time"
        value="{{settings.defaultStartLocalTime}}"
        data-field="defaultStartLocalTime"
        bindchange="onTimeChange"
      >
        <view class="tf-caption">{{settings.defaultStartLocalTime}}</view>
      </picker>
    </view>
    <view class="tf-row">
      <text class="tf-row-label">建议结束时间</text>
      <picker
        mode="time"
        value="{{settings.recommendedEndLocalTime}}"
        data-field="recommendedEndLocalTime"
        bindchange="onTimeChange"
      >
        <view class="tf-caption">{{settings.recommendedEndLocalTime}}</view>
      </picker>
    </view>
    <view class="tf-row">
      <text class="tf-row-label">默认组间休息（秒）</text>
      <slider
        min="0"
        max="600"
        step="5"
        value="{{settings.defaultRestSeconds}}"
        show-value="{{true}}"
        bindchange="onRestSecondsChange"
      />
    </view>
  </view>

  <view class="tf-section" wx:if="{{section === 'about'}}">
    <view class="tf-section-title">关于与安全</view>
    <view class="tf-row">
      <text class="tf-caption">TrainFlow 不提供医疗诊断、治疗建议，也不会判断你是否适合运动。</text>
    </view>
    <view class="tf-row">
      <text class="tf-caption">训练中如出现胸闷、剧烈头晕、关节剧痛或其他异常症状，请立即停止训练。</text>
    </view>
    <view class="tf-row">
      <text class="tf-caption">训练前后请注意补水，避免空腹或身体不适时进行高强度训练。</text>
    </view>
  </view>

  <view class="tf-section data-section" wx:if="{{section === 'data'}}">
    <view class="tf-section-title">数据备份</view>
    <text class="data-copy">备份 JSON 包含私人训练数据，请只保存到你信任的位置。导入和清除只影响本机；不会删除云端数据。</text>
    <button class="data-button" bindtap="onGenerateBackup">生成备份</button>
    <view class="data-summary" wx:if="{{exportSummary}}">
      <text>{{exportSummary.plans}} 个计划 · {{exportSummary.records}} 条记录 · {{exportSummary.bytes}} 字节</text>
      <text>校验码 {{exportSummary.checksumPrefix}}</text>
    </view>
    <button class="data-button data-button-secondary" wx:if="{{exportReady}}" bindtap="onCopyBackup">复制 JSON</button>

    <view class="data-divider"></view>
    <view class="tf-section-title">导入备份</view>
    <text class="data-copy">粘贴 JSON 后先验证并查看预览；确认前不会写入本机。</text>
    <textarea class="data-textarea" maxlength="-1" placeholder="在此粘贴 TrainFlow 备份 JSON" bindinput="onImportInput" />
    <text class="tf-caption">已输入 {{importBytes}} 字节</text>
    <button class="data-button data-button-secondary" bindtap="onPreviewImport">验证并预览</button>
    <view class="data-preview" wx:if="{{importPreview}}">
      <text class="data-preview-title">导入预览</text>
      <text>{{importPreview.counts.plans}} 个计划 · {{importPreview.counts.records}} 条记录</text>
      <text>计划：新增 {{importPreview.changes.plans.added}}，变更 {{importPreview.changes.plans.changed}}，移除 {{importPreview.changes.plans.removed}}</text>
      <text>记录：新增 {{importPreview.changes.records.added}}，变更 {{importPreview.changes.records.changed}}，移除 {{importPreview.changes.records.removed}}</text>
      <text wx:for="{{importPreview.warnings}}" wx:key="*this">{{item}}</text>
      <button class="data-button" bindtap="onConfirmImport">确认恢复本机数据</button>
    </view>

    <view class="data-divider"></view>
    <view class="danger-zone">
      <view class="tf-section-title danger-title">危险操作</view>
      <text class="data-copy">本地清除不会删除云端数据；如有未同步变更，它们会从本机移除。</text>
      <button class="danger-button" bindtap="onPrepareLocalClear">清除本机数据</button>
      <view class="data-preview danger-preview" wx:if="{{clearPreview}}">
        <text>将清除 {{clearPreview.counts.plans}} 个计划和 {{clearPreview.counts.records}} 条记录。</text>
        <text wx:for="{{clearPreview.warnings}}" wx:key="*this">{{item}}</text>
        <button class="danger-button danger-button-solid" bindtap="onConfirmLocalClear">仅清除本机数据</button>
      </view>
    </view>

    <text class="data-error" wx:if="{{dataError}}">{{dataError}}</text>
    <text class="data-notice" wx:if="{{dataNotice}}">{{dataNotice}}</text>
  </view>
</view>
